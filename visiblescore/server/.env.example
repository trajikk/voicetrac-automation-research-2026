# Server
PORT=4000

# Perplexity API (https://www.perplexity.ai/settings/api) — live web search + citations.
# Leave unset to use demo/mock data for this platform.
PERPLEXITY_API_KEY=

# OpenAI API (https://platform.openai.com/api-keys) — used with the web-search-enabled
# model as a best-effort approximation of ChatGPT's browsing behavior.
# Leave unset to use demo/mock data for this platform.
OPENAI_API_KEY=

# SerpAPI (https://serpapi.com) — Google has no official AI Overviews API, so this
# third-party SERP service is used to fetch AI Overview content when Google renders one.
# Leave unset to use demo/mock data for this platform.
SERPAPI_KEY=

# SMTP, for emailing reports to clients. Leave unset to skip sending (report still
# generates and can be downloaded manually).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
